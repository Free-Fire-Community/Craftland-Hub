# Copy this file to .env.local and fill in the values. Do NOT commit .env.local.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle by Next.js.
# For Firebase web apps these are public by design; access is secured by Firestore
# rules + Firebase Auth, not by hiding these values.
# Everything WITHOUT the NEXT_PUBLIC_ prefix is server-only and must never be exposed.

# --- Firebase (client / public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional - only if using Firebase Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google One Tap / Google Sign-In OAuth 2.0 Web client ID.
# Find it in Google Cloud Console > APIs & Services > Credentials
# (the "Web client" auto-created for your Firebase project).
# One Tap only renders on origins listed under that client's
# "Authorized JavaScript origins" (e.g. http://localhost:9002 and your domain).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- API security ---
# Server-side secret used to authorize internal API requests.
INTERNAL_API_KEY=
# Client-side key sent from the browser. NOTE: anything NEXT_PUBLIC_ is visible to
# all visitors, so this provides no real secrecy. Prefer Firebase ID-token auth.
NEXT_PUBLIC_API_KEY=

# --- Application ---
NODE_ENV=development

# --- Firebase Admin SDK (server-only) ---
# Full service account JSON as a single-line string. Server-side credential.
# NEVER commit a real value. Rotate immediately if it is ever exposed.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Upstream Map API source (server-only) ---
# Base URL of the upstream map-details API. Server-only; do NOT prefix NEXT_PUBLIC_.
MAP_API_BASE_URL=
